NODE_ENV=development
PORT=3333

# PostgreSQL (compatível com docker-compose.yml ou PostgreSQL local)
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/kanban_inteligente?schema=public

# Origem exata do frontend (CORS + Anti-CSRF + Socket.IO Origin check)
FRONTEND_ORIGIN=http://localhost:5173

# Segredos JWT distintos (mínimo 32 caracteres cada)
JWT_ACCESS_SECRET=troque_por_um_segredo_access_aleatorio_com_32_ou_mais_chars
JWT_REFRESH_SECRET=troque_por_um_segredo_refresh_diferente_com_32_ou_mais_chars

# Gemini Decisions API (opcional: ausente usa DeterministicFallbackClassifier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-decision-1
